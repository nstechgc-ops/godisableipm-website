---
layout: base.njk
---
<header class="phero"{% if image %} style="background-image:linear-gradient(rgba(34,8,52,.72),rgba(34,8,52,.88)),url('{{ image | u }}')"{% endif %}>
  <div class="wrap center">
    {% if eyebrow %}<p class="eyebrow light">{{ eyebrow }}</p>{% endif %}
    <h1>{{ title }}</h1>
  </div>
</header>
<main>
  <section><div class="wrap narrow prose">{{ content | safe }}</div></section>
  {% if donate %}{% include "give.njk" %}{% endif %}
  {% if form %}{% include "form.njk" %}{% endif %}
</main>
