<section class="give" id="give">
  <div class="wrap center">
    <p class="eyebrow">Bless Someone</p>
    <h2>A prayer goes a long way. A helping hand goes further.</h2>
    <p class="lead">Spread love and bless someone. Your gift supports our missions to women, widows and children in Cameroon.</p>
    <div class="btnrow">
      <a class="btn" href="https://www.paypal.com/donate/?business={{ site.paypalEmail | urlencode }}&item_name={{ 'Donation to God Is Able International Prayer Ministry' | urlencode }}&currency_code=USD" target="_blank" rel="noopener">Give with PayPal</a>
      <a class="btn ghost" href="https://cash.app/{{ site.cashapp }}" target="_blank" rel="noopener">Cash App {{ site.cashapp }}</a>
    </div>
  </div>
</section>
