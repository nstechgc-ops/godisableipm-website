<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and page.url != '/' %}{{ title }} | {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{% set share = (image if image and image.startsWith('/') else site.shareImage) | absUrl(site.url) %}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ share }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Lora:ital,wght@0,400;0,500;1,400&display=swap">
<link rel="stylesheet" href="/styles.css?v=7">
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"{{ site.name }}","url":"{{ site.url }}","logo":"{{ site.url }}/images/logo.png","telephone":"{{ site.phone }}","email":"{{ site.email }}","address":{"@type":"PostalAddress","addressLocality":"Clearwater","addressRegion":"FL","postalCode":"33764","addressCountry":"US"},"sameAs":[{% for s in site.socials %}"{{ s.url }}"{% if not loop.last %},{% endif %}{% endfor %}]}</script>
</head>
<body>
<header class="top">
  <div class="wrap topin">
    <a class="brand" href="/"><img src="/images/logo-horizontal.svg" alt="God Is Able International Prayer Ministries" width="160" height="46"></a>
    <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="menu"><span></span><span></span><span></span></button>
    <nav class="menu" id="menu">
      {% set links = [["/","Home"],["/about","About"],["/live","Live Prayer"],["/prayer-lines","Prayer Lines"],["/mission","Mission"],["/prayer-partners","Prayer Partners"],["/testimonies","Testimonies"],["/photos","Photos"],["/store","Store"],["/contact","Contact"]] %}
      {% for l in links %}<a{% if l[0]=="/live" %} class="navlive"{% endif %} href="{{ l[0] }}"{% if page.url == l[0] or page.url == l[0] + '/' %} aria-current="page"{% endif %}>{{ l[1] }}</a>{% endfor %}
      <a class="btn small" href="/mission#give">Give</a>
    </nav>
  </div>
</header>
{{ content | safe }}
<section class="verse">
  <div class="wrap">
    <p class="vtext">“{{ site.verse }}”</p>
    <p class="vref">{{ site.verseRef }}</p>
  </div>
</section>
{% from "icon.njk" import icon %}
<footer class="foot">
  <div class="wrap fgrid">
    <div class="fbrand">
      <a href="/" aria-label="God Is Able home"><img src="/images/logo-stacked-reverse.svg" alt="God Is Able International Prayer Ministries" width="230" height="172"></a>
      <p class="tag">{{ site.tagline }}</p>
      <a class="btn small" href="/mission#give">Give</a>
    </div>
    <nav class="fcol" aria-label="Footer">
      <h4>Explore</h4>
      <ul class="flist">
        <li><a href="/live">Live Prayer</a></li>
        <li><a href="/prayer-lines">Prayer Lines</a></li>
        <li><a href="/mission">Our Mission</a></li>
        <li><a href="/testimonies">Testimonies</a></li>
        <li><a href="/photos">Photos</a></li>
        <li><a href="/store">Store</a></li>
      </ul>
    </nav>
    <div class="fcol fcontact">
      <h4>Contact</h4>
      <ul class="flist">
        <li><a class="iline" href="tel:{{ site.phone | replace('-','') }}">{{ icon("phone") }}<span>{{ site.phone }}</span></a></li>
        <li><a class="iline" href="mailto:{{ site.email }}">{{ icon("email") }}<span>{{ site.email }}</span></a></li>
        <li><a class="iline" href="https://www.google.com/maps/search/?api=1&amp;query={{ site.address | urlencode }}" target="_blank" rel="noopener">{{ icon("address") }}<span>{{ site.address }}</span></a></li>
      </ul>
    </div>
    <div class="fcol">
      <h4>Follow</h4>
      <ul class="flist">
        {% for s in site.socials %}<li><a class="iline" href="{{ s.url }}" target="_blank" rel="noopener">{{ icon(s.label) }}<span>{{ s.label }}</span></a></li>{% endfor %}
      </ul>
    </div>
  </div>
  <div class="wrap">
    <div class="fbot">
      <span>&copy; 2016–{{ "" | year }} {{ site.name }}. All rights reserved.</span>
      <span class="credit">Website by <a href="https://nstechglobal.com" target="_blank" rel="noopener">NS Tech Global Consulting</a></span>
    </div>
  </div>
</footer>
<script>
(function(){var b=document.querySelector('.burger'),m=document.getElementById('menu');b.addEventListener('click',function(){var o=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!o));m.classList.toggle('open',!o);});})();
</script>
</body>
</html>
