---
layout: base.njk
permalink: /contact/
title: Contact
---
<header class="phero"><div class="wrap center"><p class="eyebrow light">Drop Your Prayer Requests or Leave a Testimony</p><h1>Contact Us</h1></div></header>
<main>
  <section><div class="wrap grid3 center">
    <div class="card"><h3>Call</h3><p><a href="tel:{{ site.phone | replace('-','') }}">{{ site.phone }}</a></p></div>
    <div class="card"><h3>Email</h3><p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p></div>
    <div class="card"><h3>Visit</h3><p>{{ site.address }}</p></div>
  </div></section>
  {% include "form.njk" %}
</main>
